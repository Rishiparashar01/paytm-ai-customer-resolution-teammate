# Paytm AI Customer Resolution Teammate — backend environment
# Copy to backend/.env and fill in real values. NEVER commit .env.

# HTTP port for the API server (1–65535)
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated CORS allowlist (required in production to allow the frontend origin)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string
# Local dev:  postgresql://postgres:postgres@localhost:5432/paytm_ai?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paytm_ai?schema=public

# Google Gemini (optional — offline deterministic planner is used when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Policy limits (see §8)
POLICY_MAX_RETRY_AMOUNT=2000
POLICY_MAX_RETRIES=1

# Rate limiter (defaults: 120 requests / 60s / IP)
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
